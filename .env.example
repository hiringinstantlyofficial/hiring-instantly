# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin used for canonical URLs, sitemap entries and OG images.
#
# REQUIRED IN PRODUCTION. Leaving this on localhost publishes localhost
# canonicals and sitemap entries, which costs the site all of its organic
# traffic. On Vercel the deployment host is used as a fallback for previews,
# but the production domain must be set here explicitly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra hostnames allowed to serve company logos through next/image, comma
# separated (e.g. "cdn.example.com,logo.clearbit.com"). The Supabase Storage
# host is always allowed. Logos on any other host still render, but as a plain
# <img> that bypasses the image optimiser — this list is what keeps the
# optimiser from being usable as an open image proxy.
NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional: analytics is
# simply not loaded when this is empty.
#
# Only loaded in production builds, and only on the public pages — /admin is
# never measured. A UA-… or GTM-… value is rejected with a warning rather than
# silently doing nothing. Vercel preview deployments also run as production, so
# leave this unset on the preview environment to keep preview traffic out of
# your reports.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Durable rate limiting for the contact and newsletter forms. Optional: when
# unset the limiter falls back to an in-memory map, which on serverless is
# per-instance and resets on cold start. Create a free Upstash Redis database
# and paste its REST credentials to make the limit actually hold.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email for the employer portal (ZeptoMail by Zoho). Optional in
# dev: with no token set, every send is skipped with a console warning and
# nothing fails — submissions and approvals still work, the recruiter just
# gets no email.
#
# ZeptoMail dashboard → your Mail Agent → Setup Info → API → "Send Mail Token".
# Paste it with or without the leading "Zoho-enczapikey " scheme.
#
# NOTE: this token covers only the app's own emails (submission received,
# approved, changes requested, digests). The magic-link emails come from
# Supabase Auth — point its SMTP settings at ZeptoMail's relay separately; see
# README §4.
ZEPTOMAIL_TOKEN=
# ZeptoMail is region-locked. Defaults to the India data centre
# (https://api.zeptomail.in); set https://api.zeptomail.com if the Zoho
# account was created in the global DC — a token from one DC 401s on the other.
ZEPTOMAIL_API_BASE=
# The From header, e.g. "HiringInstantly <no-reply@hiringinstantly.in>". The
# domain must be verified in the ZeptoMail Mail Agent (SPF + DKIM records);
# ZeptoMail has no unverified fallback sender.
EMAIL_FROM=
# Where "new submission" review digests are sent. Falls back to the site's
# contact address.
ADMIN_NOTIFICATION_EMAIL=
